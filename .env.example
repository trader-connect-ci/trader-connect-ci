# Copie ce fichier en ".env.local" et remplis les vraies valeurs (jamais dans ".env.example")

# Trouvées dans Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète Supabase (Project Settings → API → service_role) — NE JAMAIS exposer côté navigateur
SUPABASE_SERVICE_ROLE_KEY=
